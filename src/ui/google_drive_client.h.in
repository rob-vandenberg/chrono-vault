#pragma once

// --- Version ------------------------------------------------------------
// google_drive_client.h.in 0.8.115

// --- Version history ----------------------------------------------------
// v0.8.115: Initial release: the program's Google client, filled in by the build (D-080)

// Filled in by CMake from CHRONO_VAULT_GOOGLE_CLIENT_ID and
// CHRONO_VAULT_GOOGLE_CLIENT_SECRET, which the build scripts give from a
// private file; the values never stand in a file in git. Empty: no Google
// Drive in this build (the owner, Q5, Q6).
#define CHRONO_VAULT_GOOGLE_CLIENT_ID "@CHRONO_VAULT_GOOGLE_CLIENT_ID@"
#define CHRONO_VAULT_GOOGLE_CLIENT_SECRET "@CHRONO_VAULT_GOOGLE_CLIENT_SECRET@"
