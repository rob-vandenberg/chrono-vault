# ChronoVaultBuild.cmake 0.0.1

# --- Version history ----------------------------------------------------
# v0.0.1: Initial release

# The build settings every target of our own shares: warnings treated as
# errors, so a clean build is checked by the build itself, and the
# sanitizer build when CHRONO_VAULT_SANITIZE is on.

if(CHRONO_VAULT_SANITIZE)
    if(MSVC)
        message(FATAL_ERROR "CHRONO_VAULT_SANITIZE is for GCC and Clang")
    endif()
    add_compile_options(-fsanitize=address,undefined -fno-omit-frame-pointer -fno-sanitize-recover=undefined)
    add_link_options(-fsanitize=address,undefined)
endif()

function(chrono_vault_strict_warnings target)
    if(MSVC)
        target_compile_options(${target} PRIVATE /W4 /WX)
    else()
        target_compile_options(${target} PRIVATE -Wall -Wextra -Wpedantic -Werror)
    endif()
endfunction()
